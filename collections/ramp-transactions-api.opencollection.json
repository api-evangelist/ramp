{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ramp Developer Accounts Transactions API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ramp.com/developer/v1/transactions",
            "params": [
              {
                "name": "from_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "to_date",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.ramp.com/developer/v1/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns a paginated list of transactions for the organization."
        },
        {
          "info": {
            "name": "Retrieve a transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ramp.com/developer/v1/transactions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.ramp.com/developer/v1/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve a transaction"
        }
      ]
    }
  ],
  "bundled": true
}